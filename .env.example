# Copy to .env and fill in. .env is git-ignored; this template never holds values.
#
# Both are OPTIONAL. The projected-area engine is fully deterministic and runs
# with neither key set — AI is used only to interpret what geometry *means*
# (view classification, layer and label reading, ranking footprint candidates),
# never to produce a measurement. See CONSTITUTION §7 and the README.

# Claude — engineering reasoning, drawing interpretation, footprint comparison.
CLAUDE_API_KEY=

# Gemini — multimodal: view recognition, title-block and equipment-region detection.
GEMINI_API_KEY=

# ── Persistence (optional) ──────────────────────────────────────────────────
#
# With no DATABASE_URL the application runs exactly as it otherwise would and
# simply keeps no history: analyses are measured but not saved, and /health says
# so. Nothing about a measurement depends on this.
#
# On Render, set DATABASE_URL to the database's **internal** URL — the service and
# the database are in the same region and the internal address never leaves
# Render's network. The external URL is for local development and for migrations
# run by hand.
#
# This file holds placeholders only. Never commit a real value.
DATABASE_URL=

# Every object this application creates lives in this schema, and it never reads
# or writes anything outside it. The instance is shared with another application.
DATABASE_SCHEMA=projection_area
