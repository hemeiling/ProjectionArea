# Copy to .env and fill in. .env is git-ignored; this template never holds values.
#
# Both are OPTIONAL. The projected-area engine is fully deterministic and runs
# with neither key set — AI is used only to interpret what geometry *means*
# (view classification, layer and label reading, ranking footprint candidates),
# never to produce a measurement. See CONSTITUTION §7 and the README.

# Claude — engineering reasoning, drawing interpretation, footprint comparison.
CLAUDE_API_KEY=

# Gemini — multimodal: view recognition, title-block and equipment-region detection.
GEMINI_API_KEY=
